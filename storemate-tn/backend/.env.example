ENV=development

DATABASE_URL=postgresql+asyncpg://storemate:storemate@db:5432/storemate

JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173

MEDIA_ROOT=media
MEDIA_URL_PREFIX=/media
MAX_LOGO_UPLOAD_MB=5

# Transactional email (low-stock alerts, Pro Max digests) — leave SMTP_HOST
# unset in dev; the service logs and skips instead of faking a send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@storematetn.in
SMTP_USE_TLS=true

SCHEDULER_ENABLED=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
