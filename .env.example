# Production-only variables for docker-compose.prod.yml. Copy to `.env` on
# the VPS (never commit the real file — see .gitignore) and fill in real
# values. Local dev doesn't need this file: docker-compose.yml alone has
# safe dev-only defaults baked in.

# --- Database ---
POSTGRES_USER=storemate
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-to-a-real-random-value
POSTGRES_DB=storemate

# --- Backend ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-real-random-value
# Comma-separated, no trailing slash — the real frontend origin(s) only.
CORS_ORIGINS=https://storematetn.in
BACKEND_WORKERS=2

# --- Frontend (baked in at build time — see frontend/Dockerfile) ---
VITE_API_BASE_URL=https://storematetn.in/api/v1

# --- Domain / TLS ---
DOMAIN=storematetn.in
# Only used by the standalone nginx+certbot path (docker-compose.prod.yml's
# own nginx/certbot services) — leave as-is if you're using
# docker-compose.traefik.yml instead (an existing Traefik owns TLS there).
CERTBOT_EMAIL=you@example.com

# --- Only needed with docker-compose.traefik.yml (deploying alongside an
# existing Traefik-fronted stack, e.g. n8n, that already owns ports
# 80/443) — see that file's header comment. ---
# The existing stack's Docker network Traefik is attached to, e.g. n8n_default.
TRAEFIK_NETWORK=n8n_default
# The certresolver name from that Traefik instance's own command/config.
TRAEFIK_CERT_RESOLVER=mytlschallenge

# --- Transactional email (optional — leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@storematetn.in
SMTP_USE_TLS=true
