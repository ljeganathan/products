# --- Node / frontend ---------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo

# --- Python / backend ----------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Env files -------------------------------------------------------------
.env
.env.*
!.env.example

# --- Editors / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*

# --- Uploads (local disk storage, see CLAUDE.md §2) -------------------------
backend/uploads/

# --- Deploy artifacts (see scripts/backup_db.sh, docs/DEPLOYMENT.md) --------
/backups/

# --- print-agent --emulate mode output (see print-agent/README.md) ---------
print-agent/emulated_prints/
print-agent/logs/

# --- print-agent installer build output (see print-agent/installer/) -------
# PyInstaller's own dist/ output is also covered by the blanket dist/ rule above.
# The .spec files it writes bake in the building machine's absolute paths and are
# freshly regenerated by installer/build.py every run — not meaningful to commit.
print-agent/build/
print-agent/installer/*.spec
