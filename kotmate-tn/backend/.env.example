ENV=development
# Superuser connection — Alembic migrations only.
DATABASE_URL=postgresql+asyncpg://kotmate:kotmate@postgres:5432/kotmate
# Non-superuser connection the app runs as (created by the
# a0b03cc2e4a0_create_non_superuser_app_role migration) — Postgres RLS is bypassed by
# superusers, so this is required for RLS to do anything.
APP_DATABASE_URL=postgresql+asyncpg://kotmate_app:kotmate_app@postgres:5432/kotmate
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]
