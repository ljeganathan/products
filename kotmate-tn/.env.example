# Production-only variables for docker-compose.prod.yml /
# docker-compose.traefik.yml. Copy to `.env` on the VPS (never commit the
# real file — see .gitignore) and fill in real values. Local dev doesn't
# need this file: docker-compose.yml alone has safe dev-only defaults baked in.

# --- Database ---
POSTGRES_USER=kotmate
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-to-a-real-random-value
POSTGRES_DB=kotmate
# Password for the non-superuser `kotmate_app` role the app actually runs as
# (Postgres RLS enforcement — see
# backend/alembic/versions/a0b03cc2e4a0_create_non_superuser_app_role.py).
# Generate with: openssl rand -base64 32
APP_DB_PASSWORD=change-me-to-a-real-random-value

# --- Backend ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-real-random-value
# Must be a JSON array string (matches app/core/config.py's `list[str]`
# field), not comma-separated — the real frontend origin only, no trailing slash.
CORS_ORIGINS=["https://app.kotmatetn.in"]
BACKEND_WORKERS=2

# --- Frontend (baked in at build time via frontend/Dockerfile's
# VITE_API_URL build arg) ---
# Leave blank (default) so the built app calls same-origin relative paths —
# correct as long as this container's own nginx (frontend/nginx.conf) proxies
# /api, /uploads, /ws to the backend, which is the standard prod topology.
# Only set this to a real https://... URL if the API ever moves to its own domain.
VITE_API_URL=

# --- Domain / TLS ---
DOMAIN=app.kotmatetn.in
# The marketing site's own domain (the bare apex — not a subdomain of DOMAIN
# above). Routed together with its www. subdomain by the same Traefik rule
# (docker-compose.traefik.yml's `landing` service) — see docs/LANDING_PAGE.md.
LANDING_DOMAIN=kotmatetn.in

# --- Traefik co-location (this VPS already runs n8n + storemate-tn behind a
# shared Traefik instance that owns host ports 80/443 — see docs/DEPLOYMENT.md) ---
# The existing stack's Docker network Traefik is attached to, e.g. n8n_default.
TRAEFIK_NETWORK=n8n_default
# The certresolver name from that Traefik instance's own command/config.
TRAEFIK_CERT_RESOLVER=mytlschallenge
